# Adresse exacte du point d'entree JSON-RPC Zabbix.
ZABBIX_API_URL=https://172.16.132.86/api_jsonrpc.php

# HTTP n'est autorise que par choix explicite. A eviter sur un reseau critique.
ZABBIX_ALLOW_INSECURE_HTTP=false

# Methode recommandee : creer un jeton API en lecture seule dans Zabbix.
ZABBIX_API_TOKEN=

# Alternative si l'instance ne propose pas de jeton API.
ZABBIX_USERNAME=
ZABBIX_PASSWORD=

# Noms des groupes Zabbix a surveiller. Laisser vide pour ne pas filtrer par groupe.
ZABBIX_HOST_GROUPS=Switches,AP

# Frequence de consultation de Zabbix par le serveur, en secondes.
POLL_INTERVAL_SECONDS=45

# Port d'ecoute de ce tableau de bord.
PORT=3100

# Le dashboard est local au poste NOC. Ne pas exposer ce port sur le reseau.
HOST=127.0.0.1
