# Adresse exacte du point d'entree JSON-RPC Zabbix.
ZABBIX_API_URL=https://172.16.132.86/api_jsonrpc.php

# HTTP n'est autorise que par choix explicite. A eviter sur un reseau critique.
ZABBIX_ALLOW_INSECURE_HTTP=false

# Methode recommandee : creer un jeton API en lecture seule dans Zabbix.
ZABBIX_API_TOKEN=

# Alternative si l'instance ne propose pas de jeton API.
ZABBIX_USERNAME=
ZABBIX_PASSWORD=

# Noms des groupes Zabbix a surveiller. Laisser vide pour ne pas filtrer par groupe.
ZABBIX_HOST_GROUPS=Switches,AP

# Frequence de consultation de Zabbix par le serveur, en secondes (minimum : 5).
# Les nouvelles mesures ICMP dependent aussi de l'intervalle configure dans Zabbix.
POLL_INTERVAL_SECONDS=45

# Un statut web plus ancien que cette duree est affiche comme inconnu, jamais comme faussement UP.
WEB_STATUS_STALE_SECONDS=180

# Ajoute une panne artificielle clairement marquee TEST. Laissez false en production.
NOC_TEST_MODE=false

# Secret necessaire uniquement pour enregistrer les reglages depuis /settings.html.
# Generez une valeur longue et aleatoire, puis gardez ce fichier en chmod 600.
NOC_ADMIN_TOKEN=

# Port d'ecoute de ce tableau de bord.
PORT=3100

# Le dashboard est local au poste NOC. Ne pas exposer ce port sur le reseau.
HOST=127.0.0.1
